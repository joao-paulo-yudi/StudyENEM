# Copie para .env e preencha: cp .env.example .env
# O .env não é versionado. O Compose o lê automaticamente da raiz do repositório.
#
# No ambiente de avaliação (docker-compose.avaliacao.yml), POSTGRES_PASSWORD e JWT_KEY são
# obrigatórios. No docker-compose.yml sozinho (desenvolvimento), se ausentes, valem valores
# de desenvolvimento.

# Senha do PostgreSQL. Use só letras e números: ela entra na connection string.
# Gere com: openssl rand -hex 16
# Atenção: o PostgreSQL só lê a senha ao criar o volume. Para trocá-la depois, recrie o
# volume (docker compose ... down -v), o que apaga o banco.
POSTGRES_PASSWORD=

# Chave de assinatura dos tokens JWT, com no mínimo 32 caracteres.
# Gere com: openssl rand -hex 32
JWT_KEY=

# ID do cliente OAuth 2.0 do Google, para o botão "Continuar com Google" (opcional).
# Vazio desabilita o login com Google e esconde o botão.
# Onde obter: Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth
# (tipo "Aplicativo da Web"). Formato: <números>-<letras>.apps.googleusercontent.com
# Passo a passo e origens a cadastrar: docs/LOGIN_GOOGLE.md
# Não é segredo (o navegador o recebe), e não há client secret neste fluxo.
# Vale para o docker-compose.yml. No `dotnet run`, use user-secrets (veja o doc acima).
# Também vale no ambiente de avaliação (origem https://<máquina>.ts.net cadastrada no Console).
# Para desligar o Google só na avaliação, descomente a linha AVALIACAO_GOOGLE_CLIENT_ID= abaixo (vazia).
GOOGLE_CLIENT_ID=
# AVALIACAO_GOOGLE_CLIENT_ID=

# Contas de demonstração do ambiente de avaliação: demo01@studyenem.com .. demoNN@studyenem.com,
# todas com o mesmo histórico de simulados e a mesma senha (entregue aos avaliadores).
# DEMO_ACCOUNTS: quantidade de contas (1 a 99, padrão 5). DEMO_PASSWORD: obrigatória na avaliação.
DEMO_ACCOUNTS=5
DEMO_PASSWORD=

# Acesso à URL pública da avaliação. Vazio ou "false": aberto a qualquer pessoa. "true": exige o link de
# convite de cada avaliador (scripts/avaliacao.sh convites), e sem ele a aplicação mostra "Acesso restrito".
ACESSO_RESTRITO=false

# Porta local do ambiente de avaliação (nginx), ligada só a 127.0.0.1.
APP_PORT=8088

# Publicação (docs/AVALIACAO_REMOTA.md, seção 1.3): "funnel" usa o Tailscale Funnel, de URL estável
# https://studyenem.<tailnet>.ts.net. Vazio ou "quick": quick tunnel da Cloudflare, de URL temporária.
TUNNEL=funnel
# Chave de autenticação do Tailscale (https://login.tailscale.com/admin/settings/keys), necessária no
# primeiro "up" com TUNNEL=funnel. Depois o login fica guardado no volume e a chave não é mais usada
# (pode expirar). O login por link não serve no container: ele reinicia antes de o login terminar.
# É uma credencial: não compartilhe.
TS_AUTHKEY=
